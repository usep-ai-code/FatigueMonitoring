{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}      {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fatigue-monitoring-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FatigueMonitoring.Web.Api",
      "Environment": "Production"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlmisis-prod.public.6273d55d722a.database.windows.net,3342;Database=SHE_DB;User Id=she;Password=sisshe!@#123;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "ExternalApi": {
    "BaseUrl": "https://api-platform-integrator.transtrack.co/api/v1",
    "Username": "sis@mdvr",
    "Password": "Sis@mdvr12345",
    "TokenRefreshIntervalMinutes": 1
  },
  "BackgroundJob": {
    "DataFetchIntervalSeconds": 90,
    "HeartbeatIntervalSeconds": 30,
    "InitialStartTime": "2026-02-03 00:00:00",
    "FetchWindowMinutes": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "https://fatigue-monitoring.azurewebsites.net",
      "https://fatigue-monitoring-backend.azurewebsites.net"
    ]
  }
}
